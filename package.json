{
  "name": "letras-ascii",
  "version": "1.0.0",
  "private": true,
  "description": "Convierte una canción y su letra en un detalle animado en ASCII que reacciona a la música y se comparte como un solo HTML.",
  "author": "Miguel Huerta Bautista",
  "license": "ISC",
  "homepage": "https://letras-ascii.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/M1gu3hb/Letras-ascii.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "lint": "eslint js scripts test build.mjs eslint.config.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test": "npm run lint && npm run test:unit && npm run build && npm run test:browser"
  },
  "keywords": [
    "ascii",
    "karaoke",
    "lyrics",
    "canvas",
    "web-audio"
  ],
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "playwright-core": "^1.64.1"
  }
}
